#!/bin/bash

set -euo pipefail

choice=$(
  printf '%s\n' Lock Suspend Reboot Shutdown |
    fuzzel --dmenu --prompt='power > ' --lines=4
) || exit 0

case "$choice" in
  Lock) exec "$HOME/.local/bin/lock" ;;
  Suspend) systemctl suspend ;;
  Reboot) systemctl reboot ;;
  Shutdown) systemctl poweroff ;;
  *) exit 0 ;;
esac
