#!/usr/bin/env python3
"""Show every niri binding in fuzzel, so they can be searched."""

import os
import re
import subprocess
import sys

CONFIG = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "niri",
    "config.kdl",
)

INCLUDE = re.compile(r'^include\s+(?:optional=true\s+)?"([^"]+)"')
ENTRY = re.compile(r"([^\s{}]+)([^{}]*?)\{([^{}]*)\}")
TITLE = re.compile(r'hotkey-overlay-title="([^"]*)"')


def read_config(path, seen=None):
    """The config and everything it includes, as one text."""
    seen = set() if seen is None else seen

    path = os.path.abspath(os.path.expanduser(path))
    if path in seen:
        return ""
    seen.add(path)

    with open(path) as f:
        text = f.read()

    parts = []
    for line in text.splitlines():
        match = INCLUDE.match(line.strip())
        if not match:
            parts.append(line)
            continue

        target = match.group(1)
        if not os.path.isabs(target):
            target = os.path.join(os.path.dirname(path), target)
        if os.path.exists(target):
            parts.append(read_config(target, seen))

    return "\n".join(parts)


def binds():
    text = read_config(CONFIG)

    start = text.find("binds {")
    if start == -1:
        return []

    depth = 0
    end = None
    for index in range(start, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                end = index
                break
    if end is None:
        return []

    body = re.sub(r"//[^\n]*", "", text[start:end]).replace("binds {", "", 1)

    rows = []
    for key, props, action in ENTRY.findall(body):
        action = action.strip().rstrip(";").replace('"', "")
        if not action:
            continue

        # A titled bind is described by its title; otherwise the action is all
        # we have to go on.
        title = TITLE.search(props)
        description = title.group(1) if title else action

        rows.append((" ".join(f"{key} {TITLE.sub('', props)}".split()), description))

    return rows


def main():
    rows = binds()
    if not rows:
        return 1

    width = max(len(binding) for binding, _ in rows)
    listing = "\n".join(f"{binding:<{width}}   {action}" for binding, action in rows)

    subprocess.run(
        ["fuzzel", "--dmenu", "--prompt=keys > ", "--lines=15", "--width=76"],
        input=listing,
        text=True,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
