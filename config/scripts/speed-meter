#!/usr/bin/env python3
"""Waybar module: the last speed test, with a meter drawn in the tooltip."""

import json
import math
import os
import time

ACCENT = "#89b4fa"
MUTED = "#6c7086"

CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "algeos",
    "speed.json",
)


def meter(value, ceiling, width=12):
    if value <= 0:
        return "\u2591" * width
    filled = round(width * math.log10(value + 1) / math.log10(ceiling))
    filled = max(0, min(width, filled))
    return "\u2588" * filled + "\u2591" * (width - filled)


def human(mbps):
    if mbps >= 1000:
        return f"{mbps / 1000:.1f} Gbps"
    if mbps >= 10:
        return f"{mbps:.0f} Mbps"
    return f"{mbps:.1f} Mbps"


def age(seconds):
    if seconds < 60:
        return f"{int(seconds)}s ago"
    if seconds < 3600:
        return f"{int(seconds // 60)}m ago"
    return f"{int(seconds // 3600)}h ago"


try:
    with open(CACHE) as f:
        data = json.load(f)
except (OSError, ValueError):
    data = {}

state = data.get("state")

if state == "running":
    text = f"<span color='{ACCENT}'>net</span> ..."
    tooltip = "Speed test running\u2026"
    css = "testing"
elif state == "error" or not data:
    text = f"<span color='{MUTED}'>net</span> --"
    tooltip = "No measurement yet \u2014 click to run a speed test"
    css = "idle"
else:
    down = data.get("download", 0) / 1_000_000
    up = data.get("upload", 0) / 1_000_000
    ping = data.get("ping", 0)

    text = f"<span color='{ACCENT}'>net</span> {down:.0f}M"
    tooltip = (
        f"<b>Internet speed</b>   <span color='{MUTED}'>{age(time.time() - data.get('time', 0))}</span>\n"
        "\n"
        f"  down  {meter(down, 1000)}  {human(down)}\n"
        f"  up    {meter(up, 1000)}  {human(up)}\n"
        f"  ping                    {ping:.0f} ms\n"
        "\n"
        f"<span color='{MUTED}'>click to test again</span>"
    )
    css = "ok"

print(json.dumps({"text": text, "tooltip": tooltip, "class": css}, ensure_ascii=False))
