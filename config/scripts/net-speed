#!/usr/bin/env python3
"""Waybar module: realtime up/down throughput of the default interface."""

import json
import os
import time

ACCENT = "#89b4fa"
MUTED = "#6c7086"

CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "algeos",
    "net-speed.json",
)


def default_iface():
    try:
        with open("/proc/net/route") as f:
            next(f)
            for line in f:
                fields = line.split()
                if len(fields) > 2 and fields[1] == "00000000":
                    return fields[0]
    except OSError:
        pass

    try:
        for name in sorted(os.listdir("/sys/class/net")):
            if name == "lo":
                continue
            with open(f"/sys/class/net/{name}/operstate") as f:
                if f.read().strip() == "up":
                    return name
    except OSError:
        pass

    return None


def counters(iface):
    base = f"/sys/class/net/{iface}/statistics"
    with open(f"{base}/rx_bytes") as f:
        rx = int(f.read())
    with open(f"{base}/tx_bytes") as f:
        tx = int(f.read())
    return rx, tx


def human(value):
    for unit, scale in (("G", 1_000_000_000), ("M", 1_000_000), ("K", 1_000)):
        if value >= scale:
            scaled = value / scale
            return f"{scaled:.1f}{unit}" if scaled < 10 else f"{scaled:.0f}{unit}"
    return f"{value:.0f}B"


iface = default_iface()

if iface is None:
    print(json.dumps({"text": f"<span color='{MUTED}'>net offline</span>", "class": "off"}))
    raise SystemExit

now = time.time()
rx, tx = counters(iface)

try:
    with open(CACHE) as f:
        previous = json.load(f)
except (OSError, ValueError):
    previous = None

down = up = 0.0
if previous and previous.get("iface") == iface and now > previous.get("time", 0):
    elapsed = now - previous["time"]
    down = max(0.0, (rx - previous["rx"]) / elapsed)
    up = max(0.0, (tx - previous["tx"]) / elapsed)

os.makedirs(os.path.dirname(CACHE), exist_ok=True)

with open(CACHE, "w") as f:
    json.dump({"iface": iface, "rx": rx, "tx": tx, "time": now}, f)

text = f"<span color='{ACCENT}'>dn</span> {human(down)} <span color='{ACCENT}'>up</span> {human(up)}"
tooltip = (
    f"<b>{iface}</b>\n"
    "\n"
    f"  down  {human(down)}/s\n"
    f"  up    {human(up)}/s\n"
    "\n"
    f"<span color='{MUTED}'>total  {human(rx)} / {human(tx)}</span>\n"
    f"<span color='{MUTED}'>click for a speed test</span>"
)

print(json.dumps({"text": text, "tooltip": tooltip, "class": "net"}, ensure_ascii=False))
