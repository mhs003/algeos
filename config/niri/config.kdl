// niri configuration — managed by algeos.
// Keyboard-first, minimal. Included files sit beside this one and are watched
// for changes along with it.
//
// niri config: https://niri-wm.github.io/niri/Configuration

include "input.kdl"
include "layout.kdl"
include "window-rules.kdl"

// Do not pop the hotkey list on every login.
hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

include "binds.kdl"
