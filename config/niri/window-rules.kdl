// No client-side titlebars anywhere; move windows by dragging with Mod held.
prefer-no-csd

// Rounded corners on every window.
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// The speed-test overlay opens as a fullscreen floating window.
window-rule {
    match app-id=r#"^algeos-speedtest$"#
    open-floating true
    open-fullscreen true
}

// Windows opened from the bar float instead of joining the layout: the wifi,
// bluetooth and system monitor TUIs, the volume window and the screenshot
// editor. A floating window keeps whatever size the application asks for,
// which is small, so the tool windows are given a share of the working area.
window-rule {
    match app-id=r#"^algeos-(impala|bluetui|btop)$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
}

// The editor sizes itself to the screenshot, which is the right size for it.
window-rule {
    match app-id=r#"^algeos\.screenshot$"#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
}
