{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "clock",
        "custom/power"
    ],

    "niri/workspaces": {
        "all-outputs": true,
        "format": "{index}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 48
    },

    "network": {
        "format-wifi": "<span color='#89b4fa'>wifi</span> {essid}",
        "format-ethernet": "<span color='#89b4fa'>eth</span> {ipaddr}",
        "format-disconnected": "<span color='#f38ba8'>offline</span>",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "alacritty -e iwctl"
    },
    "pulseaudio": {
        "format": "<span color='#89b4fa'>vol</span> {volume}%",
        "format-muted": "<span color='#f38ba8'>muted</span>",
        "tooltip-format": "{desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "backlight": {
        "format": "<span color='#89b4fa'>bri</span> {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#89b4fa'>bat</span> {capacity}%",
        "format-charging": "<span color='#a6e3a1'>bat</span> {capacity}%",
        "format-plugged": "<span color='#a6e3a1'>bat</span> {capacity}%",
        "on-click": "alacritty -e btop"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/power": {
        "format": "<span color='#f38ba8'>power</span>",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
