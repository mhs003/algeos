{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "power-profiles-daemon",
        "battery",
        "custom/net",
        "clock",
        "custom/power"
    ],

    "niri/workspaces": {
        "all-outputs": true,
        "format": "{index}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 48
    },

    "network": {
        "format-wifi": "<span color='#89b4fa'>wifi</span> {essid}",
        "format-ethernet": "<span color='#89b4fa'>eth</span> {ipaddr}",
        "format-disconnected": "<span color='#f38ba8'>offline</span>",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "alacritty --class algeos-impala -e impala"
    },
    "bluetooth": {
        "format": "<span color='#89b4fa'>bt</span>",
        "format-disabled": "<span color='#f38ba8'>bt</span>",
        "format-connected": "<span color='#89b4fa'>bt</span> {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "alacritty --class algeos-bluetui -e bluetui"
    },
    "power-profiles-daemon": {
        "format": "<span color='#89b4fa'>ppd</span> {profile}",
        "tooltip": true,
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}\n\nclick to cycle · right-click to choose",
        "on-click": "$HOME/.local/bin/power-profile",
        "on-click-right": "$HOME/.local/bin/power-profile menu"
    },
    "custom/net": {
        "exec": "$HOME/.local/bin/net-speed",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "$HOME/.local/bin/speedtest"
    },
    "pulseaudio": {
        "format": "<span color='#89b4fa'>vol</span> {volume}%",
        "format-muted": "<span color='#f38ba8'>muted</span>",
        "tooltip-format": "{desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#89b4fa'>bat</span> {capacity}%",
        "format-charging": "<span color='#a6e3a1'>bat</span> {capacity}%",
        "format-plugged": "<span color='#a6e3a1'>bat</span> {capacity}%",
        "on-click": "alacritty -e btop"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/power": {
        "format": "<span color='#f38ba8'>power</span>",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
